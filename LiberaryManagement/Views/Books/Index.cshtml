@model IEnumerable<Book>

@{
    ViewData["Book"] = "Your Table Page";
}

<h1>@ViewData["Book"]</h1>



     <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Header Column Id</th>
                <th>Header Column Title</th>
                <th>Header Column ISBN</th>
                <th>Header Column Author</th>
            </tr>
        </thead>
    @if (Model != null && Model.Any())
    {
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.ISBN</td>
                    <td>@item.Author</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        <p>No items found to display.</p>
    }
    </table>
    